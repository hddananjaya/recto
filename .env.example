NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Landing page — public try form and cloud waitlist (relative /f/{id} links)
NEXT_PUBLIC_TRY_FORM_ID="3jyji4"
NEXT_PUBLIC_CLOUD_WAITLIST_FORM_ID="36dhp8"

DATABASE_URL="postgresql://recto:recto@localhost:5433/recto?schema=public"

AUTH_SECRET="change-me-in-production"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_AUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_SERVICE_ACCOUNT_JSON=""

NEXT_PUBLIC_DEMO_MODE="false"

# Playwright E2E — enables email/password sign-in (never set in production)
# E2E_TEST_MODE="true"
# E2E_USER_EMAIL="e2e@recto.test"
# E2E_USER_PASSWORD="recto-e2e-test-password-8chars"

# S3-compatible object storage (MinIO locally, Cloudflare R2 / AWS on Railway)
S3_ENDPOINT="http://localhost:9000"
# Browser-facing endpoint for presigned uploads (required when app runs in Docker)
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="recto-uploads"
S3_ACCESS_KEY_ID="recto"
S3_SECRET_ACCESS_KEY="recto-secret-key"
S3_FORCE_PATH_STYLE="true"
MAX_UPLOAD_BYTES="10485760"

# Local docker compose MinIO credentials
MINIO_ROOT_USER="recto"
MINIO_ROOT_PASSWORD="recto-secret-key"

# Optional — enables "Generate with AI" on /forms/new
OPEN_ROUTER_KEY=""
OPEN_ROUTER_MODEL="deepseek/deepseek-v4-flash-0731"
# OPEN_ROUTER_SITE_URL="https://your-recto-domain.com"
