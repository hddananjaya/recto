# Production — copy to .env on the server ONCE (never commit, never put in GitHub)
# DNS: A records for both domains → your Hetzner server IP

# Domains
APP_DOMAIN="recto.akila.cc"
S3_DOMAIN="files.recto.akila.cc"
ACME_EMAIL="you@example.com"

# Postgres — openssl rand -hex 32
POSTGRES_USER="recto"
POSTGRES_PASSWORD="change-me-use-openssl-rand-hex-32"
POSTGRES_DB="recto"

# Auth — openssl rand -base64 32
AUTH_SECRET="change-me-in-production"

# Google OAuth redirect: https://recto.akila.cc/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Minified JSON on one line: jq -c . service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=""

# MinIO / S3 — openssl rand -hex 32
MINIO_ROOT_USER="recto"
MINIO_ROOT_PASSWORD="change-me-use-openssl-rand-hex-32"

# Public site metadata (baked into image at build time)
NEXT_PUBLIC_TRY_FORM_ID="3jyji4"
NEXT_PUBLIC_DEMO_MODE="false"

# Optional — AI form generation
OPEN_ROUTER_KEY=""
OPEN_ROUTER_MODEL="deepseek/deepseek-v4-flash-0731"
OPEN_ROUTER_SITE_URL="https://recto.akila.cc"

MAX_UPLOAD_BYTES="10485760"
